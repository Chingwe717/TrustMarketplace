<?php
class Seller extends Controller {
    public function __construct() {
        if(!isLoggedIn() || $_SESSION['user_role'] != 'seller'){
            header('location: ' . URLROOT . '/users/login'); exit;
        }
        $this->productModel = $this->model('Product');
        $this->orderModel   = $this->model('Order');
    }

    // ── Dashboard ────────────────────────────────────────────────────────────
    public function dashboard() {
        $products = $this->productModel->getProductsBySeller($_SESSION['user_id']);
        $rev      = $this->orderModel->getSellerRevenue($_SESSION['user_id']);

        $data = [
            'title'           => 'Seller Dashboard',
            'products'        => $products,
            'total_products'  => count($products),
            'total_orders'    => $rev->total_orders  ?? 0,
            'total_revenue'   => $rev->total_revenue ?? 0,
            'trust_score'     => 85,
            'response_score'  => 90,
            'completion_rate' => 88,
            'dispute_rate'    => 2,
        ];
        $this->view('seller/dashboard', $data);
    }

    // ── Products list ────────────────────────────────────────────────────────
    public function products() {
        $search  = trim($_GET['search'] ?? '');
        $status  = trim($_GET['status'] ?? '');
        $all     = $this->productModel->getProductsBySeller($_SESSION['user_id']);

        // Filter in PHP to avoid extra queries
        $filtered = array_filter($all, function($p) use ($search, $status) {
            if ($search && stripos($p->title, $search) === false) return false;
            if ($status && $p->status !== $status) return false;
            return true;
        });

        $active = array_filter($all, fn($p) => $p->status === 'active');
        $invVal = array_sum(array_map(fn($p) => $p->price * $p->stock, $all));

        $data = [
            'title'            => 'My Products',
            'products'         => array_values($filtered),
            'total_products'   => count($all),
            'active_count'     => count($active),
            'inventory_value'  => $invVal,
            'search'           => $search,
            'status_filter'    => $status,
        ];
        $this->view('seller/products', $data);
    }

    // ── Orders ───────────────────────────────────────────────────────────────
    public function orders() {
        $filter = trim($_GET['filter'] ?? '');
        $orders = $this->orderModel->getOrdersBySeller($_SESSION['user_id'], $filter);
        $income = array_sum(array_map(fn($o) => $o->total, array_filter($orders, fn($o) => $o->status === 'confirmed')));

        $data = [
            'title'        => 'Incoming Orders',
            'orders'       => $orders,
            'filter'       => $filter,
            'total_income' => $income,
        ];
        $this->view('seller/orders', $data);
    }

    public function updateorder() {
        if($_SERVER['REQUEST_METHOD'] == 'POST' && isLoggedIn()){
            $order_id     = (int)$_POST['order_id'];
            $status       = trim($_POST['status']);
            $tracking     = trim($_POST['tracking_note'] ?? '');
            $allowed      = ['shipped','delivered','cancelled'];
            if(in_array($status, $allowed)){
                $this->orderModel->updateOrderStatus($order_id, $_SESSION['user_id'], $status, $tracking);
                flash('order_message', 'Order status updated successfully.');
            }
        }
        header('location: ' . URLROOT . '/seller/orders');
    }

    // ── Disputes ─────────────────────────────────────────────────────────────
    public function disputes() {
        $data = ['title' => 'My Disputes', 'disputes' => []];
        $this->view('seller/disputes', $data);
    }

    // ── Trust Score ──────────────────────────────────────────────────────────
    public function trustscore() {
        $data = ['title' => 'Trust Score'];
        $this->view('seller/trustscore', $data);
    }
}
